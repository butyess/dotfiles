{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
      "@mohak34/opencode-notifier@latest",
  ],
  "formatter": false,
  "lsp": false,
  "mcp": {
    "blender-mcp": {
      "type": "local",
      "command": ["uvx", "blender-mcp"],
      "enabled": true,
      "environment": {
        "BLENDER_HOST": "localhost",
        "BLENDER_PORT": "9876"
      }
    }
  }
}
